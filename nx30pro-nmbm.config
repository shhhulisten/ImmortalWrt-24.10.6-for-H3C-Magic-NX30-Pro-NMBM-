name: Build ImmortalWrt 24.10.6 for H3C NX30 Pro (NMBM)

on:
  workflow_dispatch:
  push:
    paths:
      - 'nx30pro-nmbm.config'
      - '.github/workflows/build-nx30pro.yml'

permissions:
  contents: write

env:
  SRC_TAG: v24.10.6
  UPSTREAM_VERMAGIC: 6.6.133-1-a8b93917f464536104594f27d870028d

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 350

    steps:
      - name: Checkout build recipe
        uses: actions/checkout@v4

      - name: Free disk space
        run: |
          echo "--- before ---"
          df -h /
          sudo rm -rf /usr/share/dotnet \
                      /usr/local/lib/android \
                      /opt/ghc \
                      /opt/hostedtoolcache/CodeQL \
                      /usr/local/share/boost \
                      /usr/share/swift \
                      /usr/local/.ghcup 2>/dev/null || true
          sudo apt-get clean
          echo "--- after ---"
          df -h /

      - name: Install build dependencies
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends \
            build-essential clang flex bison g++ gawk gettext git \
            libncurses-dev libssl-dev python3 python3-setuptools python3-pip \
            rsync unzip zip file wget curl ca-certificates ccache \
            device-tree-compiler libelf-dev libtool autoconf automake pkg-config \
            subversion swig texinfo bc cpio squashfs-tools \
            liblzo2-dev libzstd-dev libgmp-dev libmpc-dev libmpfr-dev \
            python3-ply python3-yaml ecj fastjar gcc-multilib g++-multilib \
            nano qemu-utils
          sudo apt-get install -y --no-install-recommends \
            upx-ucl antlr3 asciidoc intltool help2man || true
          ccache --version | head -1

      - name: Clone ImmortalWrt source (${{ env.SRC_TAG }})
        run: |
          git clone --depth=1 -b "${SRC_TAG}" \
            https://github.com/immortalwrt/immortalwrt.git openwrt
          cd openwrt
          echo "HEAD = $(git rev-parse HEAD)"
          git log -1 --format='%H %ci %s'

          echo "=== 版本标识自检（应与官方发布产物一致）==="
          echo "version 文件内容: $(cat version)"
          echo "version.date    : $(cat version.date)"
          echo "version.mk 默认值:"
          grep -nE 'VERSION_NUMBER\)?,24\.10\.6|VERSION_REPO\)?,https|VERSION_CODE\)?,r' include/version.mk || true

          echo "=== feeds 锁定情况（tag 上应当是 SHA，而不是分支名）==="
          cat feeds.conf.default
          if ! grep -q '\^[0-9a-f]\{40\}' feeds.conf.default; then
            echo "::warning::feeds.conf.default 未锁定到具体 commit，本次构建的包版本可能漂移"
          fi

      - name: Update Feeds & Setup PassWall 2 (Fake-IP & Routing)
        run: |
          cd openwrt

          # 1. 更新官方基础 feeds 索引
          ./scripts/feeds update -a

          # 2. 升级 Golang 至 1.23+（sing-box / xray-core 编译必需）
          rm -rf feeds/packages/lang/golang
          git clone --depth=1 https://github.com/sbwml/packages_lang_golang -b 23.x feeds/packages/lang/golang

          # 3. 彻底清理旧目录，避免冲突
          rm -rf package/helloworld package/passwall*

          # 4. 拉取 openwrt_helloworld v5（自带原生 luci-app-passwall2 与全套核心源码）
          git clone --depth=1 https://github.com/sbwml/openwrt_helloworld.git -b v5 package/helloworld

          # 5. 安装 feeds 并建立依赖符号链接
          ./scripts/feeds install -a

      - name: Restore ccache
        uses: actions/cache@v4
        with:
          path: |
            openwrt/.ccache
            ~/.ccache
          key: ccache-nx30pro-${{ env.SRC_TAG }}-${{ hashFiles('nx30pro-nmbm.config') }}-${{ github.run_number }}
          restore-keys: |
            ccache-nx30pro-${{ env.SRC_TAG }}-${{ hashFiles('nx30pro-nmbm.config') }}-
            ccache-nx30pro-${{ env.SRC_TAG }}-
            ccache-nx30pro-

      - name: Load config and verify selections
        run: |
          echo "==== 载入配置文件 ===="
          CONFIG_FILE=$(find "$GITHUB_WORKSPACE" -maxdepth 3 -type f \( -name "nx30pro-nmbm.config" -o -name "*nx30pro*.conf" -o -name ".config" \) ! -path "*/openwrt/*" | head -n 1)
          if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ]; then
            echo "找到目标配置文件: $CONFIG_FILE"
            cp -f "$CONFIG_FILE" openwrt/.config
          else
            echo "::error::未找到 nx30pro-nmbm.config！"
            exit 1
          fi

          cd openwrt
          make defconfig

          fail=0
          chk_on() {
            if grep -q "^$1=y" .config; then
              echo "  [OK]      $1"
            else
              echo "  [缺失!!]  $1  ($2)"
              fail=1
            fi
          }
          chk_off() {
            if grep -q "^# $1 is not set" .config; then
              echo "  [已关闭]  $1"
            elif grep -q "^$1=y" .config; then
              echo "  [未关闭!] $1  ($2)"
              fail=1
            else
              echo "  [不适用]  $1"
            fi
          }

          echo "=== 1. 设备符号（拼写取自官方 config.buildinfo）==="
          grep -o 'CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c[^=]*' .config | sort -u
          chk_on CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-nmbm \
                 "NX30 Pro NMBM 设备未被选中"
          chk_on CONFIG_TARGET_PER_DEVICE_ROOTFS "未按设备裁剪 rootfs，体积会失控"

          echo "=== 2. 代理包与子选项（PassWall 2 + Fake-IP + 分流架构）==="
          chk_on CONFIG_PACKAGE_luci-app-passwall2 "feeds 里可能没有 luci-app-passwall2"
          
          # 双向兼容检查核心开关（同时支持 Makefile 连字符与宏命名）
          chk_core() {
            local label="$1"
            shift
            local found=0
            for symbol in "$@"; do
              if grep -q "^${symbol}=y" .config; then
                found=1
                echo "  [OK]      $symbol ($label)"
                break
              fi
            done
            if [ "$found" -eq 0 ]; then
              echo "  [缺失!!]  $label 核心在 .config 中未开启"
              fail=1
            fi
          }

          chk_core "Sing-Box 核心 (Fake-IP 虚拟池/TUN 必需)" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_sing-box CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox CONFIG_PACKAGE_sing-box
          chk_core "Xray 核心" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_xray CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray CONFIG_PACKAGE_xray-core
          chk_core "Hysteria2 客户端" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_hysteria CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria CONFIG_PACKAGE_hysteria
          chk_core "Shadowsocks-Rust 客户端" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_shadowsocks-rust CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client CONFIG_PACKAGE_shadowsocks-rust-sslocal
          chk_core "规则分流数据 (GeoIP/GeoSite)" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_geodata CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_v2ray-geodata CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Geodata CONFIG_PACKAGE_v2ray-geodata
          chk_core "ChinaDNS-NG 分流引擎" CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_chinadns-ng CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ChinaDNS_NG CONFIG_PACKAGE_chinadns-ng

          # 关闭非必要组件，节省固件闪存空间（排除 SingBox）
          for k in Xray_Plugin V2ray_Plugin NaiveProxy \
                   Shadowsocks_Rust_Server V2ray_Geoview Shadow_TLS \
                   tuic_client Simple_Obfs Haproxy; do
            chk_off "CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_$k" \
                    "该组件非必须，开启会增大固件体积"
          done

          echo "  --- 中文界面开关 ---"
          chk_on CONFIG_LUCI_LANG_zh_Hans "中文界面总开关；关掉后 LuCI 会退回英文"
          for p in base firewall package-manager argon-config passwall2 ttyd upnp; do
            chk_on "CONFIG_PACKAGE_luci-i18n-$p-zh-cn" "该应用的汉化包缺失，界面会是英文"
          done

          # 源码目录存在性检查
          if [ ! -d package/helloworld/luci-app-passwall2 ] && [ ! -d package/feeds/luci/luci-app-passwall2 ]; then
            echo "::error::未检测到 luci-app-passwall2 源码目录"
            fail=1
          fi

          check_src() {
            if [ -n "$(find -L package/feeds package/helloworld -maxdepth 3 -type d -name "$1" -print -quit 2>/dev/null)" ]; then
              echo "  [就位]   $1"
            else
              echo "::error::$1 源码缺失，编译必然中途失败"
              fail=1
            fi
          }

          echo "  --- PassWall 2 运行时依赖是否已就位 ---"
          for p in sing-box xray-core hysteria shadowsocks-rust v2ray-geodata chinadns-ng \
                   dns2socks ipt2socks microsocks tcping curl; do
            check_src "$p"
          done

          echo "=== 2b. ZeroTier 组网（已彻底移除）==="
          chk_off CONFIG_PACKAGE_zerotier "已确认不构建 ZeroTier"
          chk_off CONFIG_PACKAGE_luci-app-zerotier "已确认不构建 ZeroTier 界面"

          echo "=== 3. 内核模块（必须此刻编入：vermagic 改变后无法事后安装）==="
          for k in kmod-nft-socket kmod-nft-tproxy kmod-nft-nat \
                   kmod-zram kmod-nft-fullconenat kmod-tcp-bbr kmod-tun \
                   kmod-inet-diag kmod-netlink-diag kmod-wireguard kmod-sched-cake; do
            chk_on "CONFIG_PACKAGE_$k" "该模块将来无法用 opkg 补装"
          done

          echo "=== 4. UPnP 后端与 DNS 劫持依赖 ==="
          chk_on CONFIG_PACKAGE_miniupnpd-nftables "选了 iptables 变体在 firewall4 下不工作"
          chk_on CONFIG_PACKAGE_dnsmasq-full "dnsmasq-full 缺失，Fake-IP nftset 将失效"

          echo "=== 5. 构建开关（buildbot / 调试专用项必须关）==="
          for k in CONFIG_ALL_KMODS CONFIG_ALL_NONSHARED CONFIG_BUILDBOT \
                   CONFIG_BUILD_LOG CONFIG_JSON_CYCLONEDX_SBOM \
                   CONFIG_KERNEL_DEBUG_INFO CONFIG_KERNEL_DEBUG_INFO_BTF \
                   CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES \
                   CONFIG_TARGET_ALL_PROFILES; do
            chk_off "$k" "buildbot / 调试专用，打开会大幅拉长编译时间或撑爆磁盘"
          done
          chk_on CONFIG_CCACHE "没开缓存，第二次编译仍然要数小时"
          chk_on CONFIG_DEVEL "关掉后 CCACHE 的 prompt 消失，缓存开关会被静默丢弃"

          echo "=== 5b. 其余显式包与结构性符号 ==="
          for p in luci luci-compat luci-theme-argon luci-app-argon-config \
                   luci-app-ttyd luci-app-upnp openssh-sftp-server htop zram-swap; do
            chk_on "CONFIG_PACKAGE_$p" "该包静默未被选中，刷完不会有"
          done
          for k in CONFIG_TARGET_mediatek CONFIG_TARGET_mediatek_filogic \
                   CONFIG_TARGET_MULTI_PROFILE CONFIG_IMAGEOPT \
                   CONFIG_VERSIONOPT CONFIG_VERSION_FILENAMES; do
            chk_on "$k" "结构性符号，失效会导致目标/版本信息不对"
          done

          if ! grep -q '^CONFIG_VERSION_NUMBER="24.10.6-nx30pro"' .config; then
            echo "::error::自定义版本号未生效 —— VERSIONOPT 很可能被丢弃了（检查 IMAGEOPT 是否打开）"
            fail=1
          else
            echo "  [OK]      CONFIG_VERSION_NUMBER=\"24.10.6-nx30pro\""
          fi

          echo
          echo "=== 6. 版本与 opkg 源（决定刷完后 opkg update 能否成功）==="
          grep -E '^CONFIG_VERSION_(NUMBER|REPO)=' .config || true
          if ! grep -q '^CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10.6"' .config; then
            echo "::error::VERSION_REPO 未生效或指向意外地址，刷完后 opkg 源可能不可用"
            fail=1
          else
            echo "  [OK]      CONFIG_VERSION_REPO 指向官方 24.10.6 发布地址"
          fi

          echo
          if [ "$fail" != "0" ]; then
            echo "::error::配置自检未通过，已中止。请检查上面标 [缺失!!] / [未关闭!] 的项。"
            exit 1
          fi
          echo "配置自检全部通过。"

      - name: Download package sources
        run: |
          cd openwrt
          make -j$(nproc) download || make -j1 download V=s

      - name: Build firmware
        id: build
        run: |
          cd openwrt
          mkdir -p "$RUNNER_TEMP/blog"
          LOG="$RUNNER_TEMP/blog/build.log"
          rc=0

          echo "==== 开始多线程并行编译 ===="
          if ! make -j$(nproc) > "$LOG" 2>&1; then
            echo "::warning::多线程并行构建遇到错误，开始启用单线程详细模式 (V=s) 精确重试并定位..."
            make -j1 V=s 2>&1 | tee -a "$LOG" || rc=1
          fi

          if [ "$rc" = "0" ]; then
            echo "==== 固件编译顺利完成 ===="
            exit 0
          fi

          # ---------- 编译失败诊断与上报 ----------
          esc() { sed -e 's/%/%25/g' -e 's/\r/%0D/g' | awk 'BEGIN{ORS=""} {print $0 "%0A"}'; }

          if [ ! -f "$LOG" ]; then
            echo "::error title=编译失败::未找到编译日志 $LOG —— 失败可能发生在 make 命令执行前"
            exit 1
          fi

          echo "编译日志总计 $(wc -l < "$LOG") 行 / $(du -h "$LOG" | cut -f1)"

          ERR_REGEX='make(\[[0-9]+\])?: \*\*\*|Error [0-9]+$|error:|fatal error:|undefined reference|No rule to make target|failed to build|build failed|panic:|syntax error|collect2: error:'
          ERRS=$(grep -nE "$ERR_REGEX" "$LOG" | tail -n 80)
          TAILB=$(tail -n 80 "$LOG")

          {
            echo "### ❌ 固件编译失败诊断报告（Run #${{ github.run_number }}）"
            echo
            echo "- **日志总量**：$(wc -l < "$LOG") 行 ($(du -h "$LOG" | cut -f1))"
            echo
            echo '#### ① 捕获的致命错误（最多显示 80 条）'
            echo '```text'
            if [ -n "$ERRS" ]; then printf '%s\n' "$ERRS"; else echo "(未匹配到常见特征行，请参阅下方日志尾部内容)"; fi
            echo '```'
            echo
            echo '#### ② 编译日志尾部 80 行'
            echo '```text'
            printf '%s\n' "$TAILB"
            echo '```'
          } >> "${GITHUB_STEP_SUMMARY:-/dev/null}" || true

          echo "---- 致命错误汇总 ----"
          if [ -n "$ERRS" ]; then printf '%s\n' "$ERRS"; else echo "(无直接特征匹配)"; fi
          echo "---- 日志最后 80 行 ----"
          printf '%s\n' "$TAILB"

          if [ -n "$ERRS" ]; then
            echo "::error title=编译错误特征匹配::$(printf '\%s\n' "$ERRS" | head -c 20000 | esc)"
          fi
          echo "::error title=构建日志尾部输出::$(printf '\%s\n' "$TAILB" | head -c 20000 | esc)"
          exit 1

      - name: Verify artifacts and report sizes
        id: verify
        run: |
          cd openwrt/bin/targets/mediatek/filogic
          echo "=== 目标镜像 ==="
          ls -lh *h3c_magic-nx30-pro-nmbm* || true
          echo
          echo "=== rootfs 与内核 ==="
          ls -lh *rootfs* *kernel* 2>/dev/null || true
          echo
          echo "=== 本固件的内核 vermagic ==="
          cd "$GITHUB_WORKSPACE/openwrt"
          for d in build_dir bin/packages bin/targets/mediatek/filogic; do
            [ -d "$d" ] || { echo "::error::工作目录基准错误：$d 不存在（当前 $(pwd)）"; exit 1; }
          done
          [ -f .config ] || { echo "::error::.config 不存在（当前 $(pwd)）"; exit 1; }
          BIN=bin/targets/mediatek/filogic

          find $BIN -name 'kmod-*.ipk' -printf '%f\n' 2>/dev/null | sort > kmods-built.txt || true
          cp kmods-built.txt $BIN/kmods-built.txt 2>/dev/null || echo "::warning::未能把 kmods-built.txt 复制进产物目录"
          cp .config $BIN/config.custom 2>/dev/null || echo "::warning::未能把 .config 复制进产物目录"
          echo "内核模块清单已落盘：kmods-built.txt（$(wc -l < kmods-built.txt 2>/dev/null || echo 0) 行）"
          echo

          VF=$(find build_dir -name .vermagic -path '*linux-mediatek_filogic*' 2>/dev/null | head -1 || true)
          if [ -n "$VF" ]; then
            echo "vermagic = $(cat "$VF")"
            echo "对照：官方 24.10.6 为 ${UPSTREAM_VERMAGIC}"
          fi
          echo
          echo "=== 本固件自带的内核模块 ==="
          head -60 kmods-built.txt || true
          echo "(共 $(wc -l < kmods-built.txt 2>/dev/null || echo 0) 个；完整清单已存 kmods-built.txt 并随产物上传)"
          echo
          echo "=== 代理核心是否真的编出来了（PassWall 2 + Fake-IP 实证核对）==="
          # 校验 passwall2 及其必须运行的核心（加入 sing-box 校验）
          for p in sing-box xray-core hysteria shadowsocks-rust-sslocal; do
            f=$(find bin/packages -name "${p}_*.ipk" -print -quit 2>/dev/null || true)
            if [ -n "$f" ]; then
              echo "  [已编出] $(basename "$f")"
            else
              echo "::error::$p 未出现在 bin/packages —— 固件将不含该代理核心"
              exit 1
            fi
          done

          # 验证 PassWall 2 主包界面产物
          PWS=$(find bin/packages -name 'luci-app-passwall2_*.ipk' -print -quit 2>/dev/null || true)
          if [ -n "$PWS" ]; then
            echo "  [已编出] $(basename "$PWS")"
          else
            echo "::error::bin/packages 里没有 luci-app-passwall2_*.ipk —— PassWall 2 界面没编出来"
            exit 1
          fi

          for p in v2ray-geoip v2ray-geosite ca-bundle chinadns-ng dns2socks ipt2socks microsocks tcping; do
            f=$(find bin/packages -name "${p}_*.ipk" -print -quit 2>/dev/null || true)
            if [ -n "$f" ]; then
              echo "  [已编出] $(basename "$f")"
            else
              echo "::warning::$p 未找到，部分辅助功能可能受限"
            fi
          done

          # TProxy 内核模块检查
          for p in kmod-nft-socket kmod-nft-tproxy kmod-nft-nat; do
            f=$(find bin/targets/mediatek/filogic -name "${p}_*.ipk" -print -quit 2>/dev/null || true)
            if [ -n "$f" ]; then
              echo "  [已编出] $(basename "$f")"
            else
              echo "::error::$p 缺失，TProxy 透明代理无法工作"
              exit 1
            fi
          done
          echo
          echo "=== 空间账 ==="
          SYS=$(ls -1$BIN/*h3c_magic-nx30-pro-nmbm-squashfs-sysupgrade.bin 2>/dev/null | head -1 || true)
          if [ -n "$SYS" ]; then
            SZ=$(stat -c \%s "$SYS")
            echo "sysupgrade.bin = $((SZ/1024)) KB"
            HEAD=$(( 67108864 - SZ ))
            echo "ubi 分区 65536 KB，扣除镜像后余约 $((HEAD/1024)) KB 给 overlay"
            if [ "$HEAD" -le 0 ]; then
              echo "::error::镜像超过 ubi 分区容量"
              exit 1
            fi
          fi
          echo
          echo "=== 产物目录总占用 ==="
          du -sh $BIN || true

      - name: Upload firmware
        if: always() && steps.build.outcome == 'success'
        uses: actions/upload-artifact@v4
        with:
          name: immortalwrt-24.10.6-nx30pro-nmbm-${{ github.run_number }}
          path: |
            openwrt/bin/targets/mediatek/filogic/*h3c_magic-nx30-pro-nmbm*
            openwrt/bin/targets/mediatek/filogic/sha256sums
            openwrt/bin/targets/mediatek/filogic/profiles.json
            openwrt/bin/targets/mediatek/filogic/config.custom
            openwrt/bin/targets/mediatek/filogic/kmods-built.txt
          if-no-files-found: error
          retention-days: 30

      - name: Publish release
        if: always() && steps.build.outcome == 'success' && steps.verify.outcome == 'success' && github.event_name != 'pull_request'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: NX30 Pro NMBM PassWall 2 build ${{ github.run_number }}
          body: |
            基于 ImmortalWrt ${{ env.SRC_TAG }} 编译的 H3C Magic NX30 Pro（NMBM 布局）固件。

            内置：PassWall 2（原生支持 Fake-IP、Sing-Box DNS 虚拟池、Xray、Hysteria2、SS-Rust 与规则分流）、UPnP (nftables)、zram-swap。
            已彻底剔除 ZeroTier 及其依赖库。

            刷写方式：进 U-Boot failsafe 界面（`http://192.168.1.1`），上传 `*-nmbm-squashfs-factory.bin`。不要刷 `-bl31-uboot.fip` 与 `-preloader.bin`。
          prerelease: true
          files: |
            openwrt/bin/targets/mediatek/filogic/*h3c_magic-nx30-pro-nmbm*
            openwrt/bin/targets/mediatek/filogic/kmods-built.txt
