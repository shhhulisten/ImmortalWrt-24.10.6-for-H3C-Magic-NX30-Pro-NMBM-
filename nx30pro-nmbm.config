#
# ImmortalWrt 24.10.6 / H3C Magic NX30 Pro (NMBM layout)
# 用途：GitHub Actions 自编译配置
#
# ── 本次改动摘要 ────────────────────────────────────────────────────────
# · luci-app-passwall  →  luci-app-passwall2（支持 FakeDNS/fakeip + 分流规则）
# · 移除：luci-app-ttyd(+汉化)、luci-app-argon-config(+汉化)、htop
# · 保留 luci-theme-argon 主题本身；保留 ZeroTier / UPnP / zram-swap / sftp
# · 分流规则依赖 geoip/geosite → 显式编入 geoview 与 v2ray-geodata
#
# ── 本文件的符号来源 ────────────────────────────────────────────────────
# 除 passwall2 相关符号外，其余符号沿用此前已对照官方 24.10.6 发布产物
# （config.buildinfo / Packages.gz）校验过的写法。
# passwall2 的 INCLUDE_* 子选项名是按上游 Makefile 惯例写的，尚未对锁定 feed
# 提交逐条核对 —— 工作流里有一步会把锁定提交下 passwall2 Makefile 的全部
# INCLUDE_* 符号打印出来，首次编译请对照日志确认。
#
# ── 两条硬约束（决定了本文件为什么要写成这样）──────────────────────────
# 1) 内核模块无法事后安装。vermagic = md5(内核配置里所有 =y/=m 行排序后)，
#    自编译的内核配置必然与官方不同 → vermagic 不同 → 官方 kmods 源里的包
#    依赖 kernel (=6.6.133~<官方vermagic>-r1)，opkg 会直接拒绝安装。
#    所以凡是「将来可能要用」的内核模块，现在就得编进去。
# 2) 用户态包可以事后安装。它们不依赖 vermagic，且本方案与官方用的是同一批
#    feed 提交，版本号一致，opkg 装得上。
#
# ── 前置条件（已用实机输出核对，2026-09-13）────────────────────────
# · 实机 cat /proc/mtd：九段分区与 24.10 NMBM DTS 逐字段一致，
#   ubi 位于 0x580000、长 0x4000000（64 MiB），erasesize 0x20000（128 KiB）。
#   ⇒ 分区布局无需变更，U-Boot 不需要动。
# · 实机 board_name 为 h3c,nx30pro，目标板名为 h3c,magic-nx30-pro-nmbm。
#   ⇒ 板名不同，须经由 U-Boot failsafe webui 刷 factory.bin；
#     不要用系统内 sysupgrade，会因设备名不符被直接拒绝。
# · 实机内存：MemTotal 230316 kB、MemAvailable 42640 kB，
#   zram 交换区 112 MiB 已用 42.4 MiB（37.8%），空载即持续换页。
#   ⇒ 这是本次升级的主要理由；关闭冗余组件主要为省内存。
#
# 说明：本文件只写「有意指定」的符号，其余由 make defconfig 自动补全。
#
# ⚠ 有一类包**不体现在任何依赖里**，却一定会进固件：target 的 Default-Packages。
#   机制：scripts/target-metadata.pl 让设备符号 select DEFAULT_<包名>，而
#   scripts/package-metadata.pl 给每个包生成 `default y if DEFAULT_<包名>`，
#   于是 make defconfig 之后这些包一律 =y。任何 INCLUDE_* 开关都管不到它们。
#   官方 profiles.json 的 default_packages 共 42 项，与 include/target.mk 推出的
#   38 项一致（官方多 autocore / kmod-gpio-button-hotplug / kmod-leds-gpio / opkg）。
#   其中 default-settings-chn 会在首次开机改写 opkg 源并设好时区，见 README。
#   这 42 项合计再带入约 93 个包 / 12.25 MB，不在下面任何体积表的口径内。
#

#
# Target System / Subtarget / Device
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
#
# 官方 release 是「一次编全部设备」的构建，我们要的是单设备，所以这里两个
# 「批量」开关都要显式定住（定义在 scripts/target-metadata.pl 生成的
# TARGET_MULTI_PROFILE 菜单段里）：
#   config TARGET_ALL_PROFILES      bool "Enable all profiles by default"                default BUILDBOT
#   config TARGET_PER_DEVICE_ROOTFS bool "Use a per-device root filesystem ..."          default BUILDBOT
# 我们的 BUILDBOT=n，两者默认都是 n。PER_DEVICE_ROOTFS 显式开 y，是为了保证
# 每台设备单独成镜像并附带自己的 profile 包；ALL_PROFILES 显式写 is not set，
# 是为了日后万一有人误开 BUILDBOT 时不会突然把 145 个设备一起编进来。
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-nmbm=y

#
# Version banner
#
# ── 为什么必须同时开 IMAGEOPT：VERSIONOPT 的 prompt 挂在它上面 ────────
# 版本菜单并不在主仓库的 config/ 目录里，而是由包元数据脚本生成：
#   scripts/package-metadata.pl 的 gen_package_config()：
#     print "menuconfig IMAGEOPT\n\tbool \"Image configuration\"\n\tdefault n\n";
#     print "source \"package/*/image-config.in\"\n";
#   ⇒ 生成的 tmp/.config-package.in 里先有 IMAGEOPT，再引入
#     package/base-files/image-config.in
#   package/base-files/image-config.in L153-154：
#     menuconfig VERSIONOPT
#       bool "Version configuration options" if IMAGEOPT   ← 关键
#       default n
#     if VERSIONOPT                                        ← L163
#       config VERSION_DIST / VERSION_NUMBER / VERSION_REPO / VERSION_FILENAMES
#     endif                                                ← L274
#
# kconfig 铁律：没有 prompt 的符号，.config 里写什么都不算数，
# make defconfig 会静默把它 reset 掉。IMAGEOPT 默认是 n，所以
# 「只写 CONFIG_VERSIONOPT=y」时它没有 prompt ⇒ 整组 VERSION_* 子项
# （它们在 if VERSIONOPT 块内）一并失去可见性、被丢弃。
# 后果：VERSION_NUMBER 的自定义值不生效，VERSION_REPO 回落到 tag 默认值，
# 编译日志里会出现「VERSION_REPO 与源码 tag 不匹配」的警告。
#
# 官方发布产物可印证：config.buildinfo 第 252 行有 CONFIG_IMAGEOPT=y，
# 紧接着才有 CONFIG_VERSIONOPT=y 与一整组 VERSION_*。
# ⇒ 顺序上 IMAGEOPT 必须先于 VERSIONOPT 出现，这里照此排列。
#
CONFIG_IMAGEOPT=y
#
# 只改「显示用」的版本号，不动 VERSION_REPO。
# opkg 源地址由 VERSION_REPO 拼接（见 include/feeds.mk：src/gz %d_core %U/...），
# 所以显式写死它，才能保证刷完之后 opkg update 指向真实存在的官方 24.10.6 仓库。
# 若把 VERSION_NUMBER 当成源路径用，会得到一个不存在的 24.10.6-nx30pro 目录。
#
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="24.10.6-nx30pro"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10.6"
CONFIG_VERSION_FILENAMES=y

#
# Build settings
#
# ── 为什么必须开 DEVEL：CCACHE 的 prompt 挂在 DEVEL 上 ────────────────
# config/Config-devel.in：
#   menuconfig DEVEL
#     config CCACHE
#       bool "Use ccache" if DEVEL     ← 只有 DEVEL=y 时这个符号才有 prompt
#     config BUILD_LOG
#       bool "Enable log files during build process" if DEVEL
# kconfig 里「没有 prompt 的符号」无法从 .config 赋值，会被 reset 成默认值。
# 所以 CONFIG_CCACHE=y 必须与 CONFIG_DEVEL=y 成对出现，否则 make defconfig
# 会静默把它丢掉，缓存失效而第二次编译仍要数小时。
#
# 注意：KERNEL_DEBUG_INFO 与 DEVEL **无关**。它的默认值来自
#   config/Config-kernel.in：
#     config KERNEL_DEBUG_INFO
#       bool "Compile the kernel with debug information"
#       default y if !SMALL_FLASH
# filogic 不属于 SMALL_FLASH，所以它的默认值本来就是 y —— 无论 DEVEL 开不开。
# 必须显式关掉，否则内核与全部模块都会带 DWARF 调试信息，镜像明显变大、
# 编译时间也显著拉长（CI 的磁盘和分钟数都耗不起）。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_BUILDBOT is not set
# CONFIG_BUILD_LOG is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_JSON_CYCLONEDX_SBOM is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES is not set
# ── 为什么这里没有 CONFIG_STRIP_KERNEL_EXPORTS ─────────────────────
# 它的 prompt 挂着 `depends on BROKEN`（config/Config-build.in L236-238），
# BROKEN 默认 n ⇒ 该符号无 prompt ⇒ 永远不写入 .config，写了也不生效。
# 官方发布产物的 config.buildinfo 全篇也查无此行。收益本来也很小，
# 真正的大头是 KERNEL_DEBUG_INFO（上面已关）。

#
# LuCI（默认只有 luci-light，这里补成完整版并中文化）
#
# ── 中文界面到底靠哪个开关（最容易写错的一处）───────────────────────
# luci 的汉化包是「按语言派生」出来的，机制在 feeds/luci/luci.mk：
#   1) luci-base 的 config 段里按语言生成一个**带 prompt** 的开关：
#        config LUCI_LANG_zh_Hans
#          tristate "Simplified Chinese (zh_Hans)"
#   2) LuciTranslation 为每个应用派生 luci-i18n-<应用>-zh-cn，并给它
#        HIDDEN:=1
#        DEFAULT:=LUCI_LANG_zh_Hans||(ALL&&m)
# 关键在 HIDDEN：hidden 包在 kconfig 里没有 prompt，取值由 LUCI_LANG_zh_Hans
# 驱动。所以 CONFIG_LUCI_LANG_zh_Hans=y 是真正生效的总开关；下面逐包列出的
# 6 行是同一结果的显式表达（官方 config.buildinfo 也是这种逐包写法），
# 汉化包体积可以忽略不计。
#
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
# 已移除：主题配置界面（主题本身保留，默认配色即可用）
# CONFIG_PACKAGE_luci-app-argon-config is not set

#
# 代理：PassWall2（支持 FakeDNS/fakeip + 分流规则）
#
# ── 为什么这里换成 passwall2 ────────────────────────────────────────
# passwall2 的节点/分流模型是「一个总节点 + 按规则分流到不同节点」，
# DNS 页面里可开启 FakeDNS（fakeip），由 Xray 核心提供，无需额外组件。
# 与旧 passwall 不能共存，上一版的 luci-app-passwall 相关符号已全部删除。
#
# ── 实际会编进固件的核心 ────────────────────────────────────────────
#   xray-core     主核心：vmess / vless / trojan / SS，FakeDNS 与分流路由都靠它
#   hysteria      Hysteria2 客户端（包名叫 hysteria，实际是 apernet/hysteria v2）
#   shadowsocks-rust-sslocal   SS 专用客户端，跑 SS 比 Xray 更省
#   v2ray-geoip / v2ray-geosite  分流规则里 geoip:cn / geosite:cn 等标签的数据源
#   geoview       把 geoip/geosite 标签展开成 IP 集合（用于 nftables 层分流）
# 注意 geoview 是**二进制程序**，不是「查看数据的界面」（此前版本注释有误）。
# 分流规则里一旦用到 geosite:/geoip: 标签，passwall2 要靠它展开，所以必须编入。
#
# ── 体积/内存说明 ───────────────────────────────────────────────────
# 旧版实测：xray-core 26.41 MB、hysteria 17.15 MB、ss-rust 7.83 MB、
# geodata 24.05 MB（Installed-Size，未压缩）。passwall2 的其余依赖包尚未实测。
# Hysteria2 常驻约 25–45 MB 内存（Go + 自有 QUIC 栈），内存紧张时首先考虑
# 是否真的需要它；不需要就把下面 INCLUDE_Hysteria 改成 is not set。
# SingBox 也能做 fakeip，但体积约 40 MB 且常驻内存明显高于 Xray，故不编。
#
# ── 关闭项：这些开关在 aarch64 上大多「默认 y」，必须逐条显式关闭 ──────
# 其中部分符号在 passwall2 里可能并不存在（例如各种 Server 变体），
# 不存在的符号写成 is not set 无害，工作流的断言会把它们标为「不适用」。
#
CONFIG_PACKAGE_luci-app-passwall2=y
# 实测：当前 passwall2 版本里 INCLUDE_Xray / INCLUDE_Hysteria / INCLUDE_V2ray_Geodata
# 这三个开关不存在（被 make defconfig 丢弃），核心已不再由 INCLUDE 开关控制。
# 所以改为直接选中包本身 —— 无论上游怎么改开关，这几个包都一定进固件。
# 旧的 INCLUDE 写法保留（存在则生效，不存在则被静默丢弃，无害）。
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Geodata=y
# geoview：INCLUDE 开关名在不同提交里叫法不同（V2ray_Geoview / Geoview），
# 两个都写，不存在的那个会被静默丢弃；同时直接选中 geoview 包本身兜底。
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Geoview=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Geoview=y
CONFIG_PACKAGE_geoview=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray_Plugin is not set
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
# 旧版 passwall 必须保持关闭，避免与 passwall2 争用 nftables / dnsmasq 规则
# CONFIG_PACKAGE_luci-app-passwall is not set

#
# VPN 组网：ZeroTier
# 包名与开关名取自锁定 feed 提交 97af1398 下的 net/zerotier/Makefile
# （PKG_VERSION 1.14.1）与 luci@adb3df4d 下的 applications/luci-app-zerotier。
#
# ── 体积代价很小：边际仅 3.47 MB ──────────────────────────────────
# 真正新增 7 个包（Installed-Size 合计 3,550 KB）：
#   libstdcpp6 2,060 KB / zerotier 1,250 KB / libminiupnpc 70 KB /
#   libnatpmp1 70 KB / libatomic1 70 KB / luci-app-zerotier 20 KB /
#   luci-i18n-zerotier-zh-cn 10 KB
# 不额外占用的依赖：kmod-tun（已在内核模块区）、libpthread、libgcc1、ip-full 等。
#
# ── 依赖满足情况：不需要额外内核模块 ──────────────────────────────
# Makefile 的 DEPENDS 是：
#   +libpthread +libstdcpp +kmod-tun +ip +libminiupnpc +libnatpmp +libatomic
# kmod-tun 已在下方内核模块区显式编入。
#
# ── 与 firewall4 的兼容性：已核对，原生适配 ──────────────────────
# 本包自带 /usr/bin/zerotier-fw4，内部直接用 nft 操作 fw4 表，
# 不需要 iptables-nft / iptables-legacy。
#
# ── 两个子开关必须显式关闭 ────────────────────────────────────────
# net/zerotier/Config.in 定义了这两个符号，default 均为 n，但符号名
# 不带 PACKAGE_ 前缀（CONFIG_ZEROTIER_ENABLE_*），容易在检查时漏掉。
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# CONFIG_ZEROTIER_ENABLE_DEBUG is not set
# CONFIG_ZEROTIER_ENABLE_SELFTEST is not set

#
# 内核模块：必须此刻编入（事后无法安装，见文件头说明）
# 以下 11 个的 Installed-Size 实测合计 550 KB，换来的是以后改需求时不用重编固件。
#
# ── passwall2 运行必需 ─────────────────────────────────────────────
# 这三个是透明代理（TProxy）的强制依赖，不写也会被依赖解析自动选中。
# 此处显式写出，是为了让 CI 自检能逐个断言 —— 缺任何一个透明代理直接不工作。
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
#
# ── 预留余量（当下用不到，但内核侧无法事后补装）──────────────────
# 内核内置的模块：zram 与 zram-swap 配套
CONFIG_PACKAGE_kmod-zram=y
# NAT 全锥型：firewall4 已依赖它，显式写出以固定行为
CONFIG_PACKAGE_kmod-nft-fullcone=y
# BBR 拥塞控制：跨境高延迟线路的吞吐提升明显
CONFIG_PACKAGE_kmod-tcp-bbr=y
# TUN 虚拟网卡：ZeroTier 需要；将来换 sing-box / clash 内核的 TUN 模式也要
CONFIG_PACKAGE_kmod-tun=y
# 连接追踪诊断
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
# WireGuard：将来若要做异地组网 / 机场走 WG，省得重编
CONFIG_PACKAGE_kmod-wireguard=y
# CAKE 队列算法：将来给多台设备做延迟控制（SQM）时要
CONFIG_PACKAGE_kmod-sched-cake=y

#
# NAT 与网络
#
# UPnP 有两个后端变体：miniupnpd-iptables / miniupnpd-nftables。
# 24.10 用的是 firewall4（nftables），必须显式指定 nftables 变体。
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

#
# 内存与运维
#
# zram-swap：用压缩内存做交换区，比闪存交换快得多，也不磨损 NAND
CONFIG_PACKAGE_zram-swap=y
# openssh-sftp-server：新版 scp 默认走 SFTP 协议，保留它才能正常 scp 传文件
CONFIG_PACKAGE_openssh-sftp-server=y
# 已移除：网页终端（有 SSH 就不需要）与 htop
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set
# CONFIG_PACKAGE_htop is not set
